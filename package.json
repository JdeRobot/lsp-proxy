    "child_process": "^1.0.2",
    "esprima": "^4.0.1",
    "events": "^3.3.0",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "js-yaml": "^3.13.1",
    "minimist": "^1.2.0",
    "net": "^1.0.2",
    "node-gyp-build": "^4.8.4",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "stream": "^0.0.3",
    "tls": "^0.0.1",
    "url": "^0.11.4",
    "utf-8-validate": "^6.0.6",
    "ws": "^6.2.1"
